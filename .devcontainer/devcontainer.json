{
  "name": "DNS Check .NET",
  "image": "mcr.microsoft.com/devcontainers/base:3-ubuntu24.04",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "installOhMyZsh": false,
      "username": "vscode",
      "upgradePackages": true
    },
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0",
      "additionalVersions": "8.0"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "32gb"
  },
  "containerEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1",
    "NUGET_XMLDOC_MODE": "skip"
  },
  "remoteUser": "vscode",
  "postCreateCommand": "dotnet --info && dotnet restore DnsCheck.slnx",
  "customizations": {
    "vscode": {
      "settings": {
        "dotnet.defaultSolution": "DnsCheck.slnx",
        "dotnet.testExplorer.enable": true,
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.dotnet-test-explorer",
        "ms-vscode.vscode-test-explorer",
        "ms-azuretools.vscode-docker",
        "github.vscode-github-actions",
        "EditorConfig.EditorConfig",
        "redhat.vscode-yaml",
        "streetsidesoftware.code-spell-checker"
      ]
    }
  }
}